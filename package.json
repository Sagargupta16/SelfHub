{
  "name": "selfhub-mcp-server",
  "version": "0.3.0",
  "description": "Personal MCP-powered digital hub - private data center with AI integration for memory, notes, and personal knowledge management",
  "mcpName": "io.github.Sagargupta16/selfhub",
  "main": "build/index.js",
  "bin": {
    "selfhub-mcp-server": "build/index.js"
  },
  "files": [
    "build",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "dev": "tsx watch src/index.ts",
    "start": "node build/index.js",
    "prepare": "pnpm run build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "test": "pnpm build && tsx --test test/*.test.ts",
    "demo": "pnpm build && tsx scripts/demo.ts",
    "seed": "tsx src/seed.ts",
    "clean": "node -e \"require('node:fs').rmSync('build',{recursive:true,force:true})\"",
    "reset": "pnpm clean && pnpm build",
    "quick-start": "pnpm build && pnpm seed && pnpm start"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "memory",
    "claude",
    "mongodb",
    "knowledge-management"
  ],
  "author": "Sagar Gupta",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sagargupta16/SelfHub.git"
  },
  "homepage": "https://github.com/Sagargupta16/SelfHub#readme",
  "bugs": {
    "url": "https://github.com/Sagargupta16/SelfHub/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "dotenv": "^18.0.8",
    "mongoose": "^9.11.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "mongodb-memory-server": "^11.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.0"
  }
}
