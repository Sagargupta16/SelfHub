{
  "name": "selfhub-mcp-server",
  "version": "0.2.5",
  "description": "Personal MCP-powered digital hub - private data center with AI integration for memory, notes, and personal knowledge management",
  "main": "build/index.js",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "dev": "tsx watch src/index.ts",
    "start": "node build/index.js",
    "prepare": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "seed": "tsx src/seed.ts",
    "clean": "node -e \"require('node:fs').rmSync('build',{recursive:true,force:true})\"",
    "reset": "pnpm clean && pnpm build",
    "quick-start": "pnpm build && pnpm seed && pnpm start"
  },
  "keywords": [
    "mcp",
    "model-context-protocol"
  ],
  "author": "Sagar Gupta",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "dotenv": "^18.0.8",
    "mongoose": "^9.11.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.0"
  }
}